{
  "name": "default",
  "version": "1.0.0",
  "engine": ">=0.1",
  "requiresPresets": ["thumb", "display", "w800", "w1600", "w2400"],
  "options": [
    { "key": "accent",        "type": "color", "label": "Accent color (blank = auto for light/dark)", "default": "" },
    { "key": "gridGap",       "type": "int",   "label": "Grid gap (px)",       "default": 8 },
    { "key": "rowHeight",     "type": "int",   "label": "Target row height",   "default": 300 },
    { "key": "panoFullWidth", "type": "bool",  "label": "Prefer full-width panoramas", "default": false }
  ]
}
